#usda 1.0
(
    defaultPrim = "construction_block"
    metersPerUnit = 1
    upAxis = "Z"
)

# Simple construction module (design 8.2): a 1.5 x 1.5 x 1 m cube ("server base / infrastructure"
# block). Placed via static_assets at several poses to form the partial structure + the module the
# transport rover delivers. Orientation [0,0,0,1] (static_assets quats are x,y,z,w). Light metal grey.
def Xform "construction_block"
{
    def Cube "geom"
    {
        double size = 1.0
        float3 xformOp:scale = (1.5, 1.5, 1.0)
        double3 xformOp:translate = (0, 0, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.55, 0.57, 0.60)]
        rel material:binding = </construction_block/Metal>
    }
    def Material "Metal"
    {
        token outputs:surface.connect = </construction_block/Metal/Shader.outputs:surface>
        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.55, 0.57, 0.60)
            float inputs:metallic = 0.6
            float inputs:roughness = 0.5
            token outputs:surface
        }
    }
}
