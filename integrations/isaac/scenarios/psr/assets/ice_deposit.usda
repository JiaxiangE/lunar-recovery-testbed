#usda 1.0
(
    defaultPrim = "ice_deposit"
    metersPerUnit = 1
    upAxis = "Z"
)

# High-albedo "water-ice deposit" marker prop for the PSR scene (no native asset in OmniLRS).
# A low flattened bluish-white dome placed at sample points; scan_spectral "reads" these.
def Xform "ice_deposit"
{
    def Sphere "geom"
    {
        double radius = 0.5
        color3f[] primvars:displayColor = [(0.85, 0.92, 1.0)]
        float3 xformOp:scale = (1, 1, 0.35)
        uniform token[] xformOpOrder = ["xformOp:scale"]
        rel material:binding = </ice_deposit/IceMat>
    }

    def Material "IceMat"
    {
        token outputs:surface.connect = </ice_deposit/IceMat/Shader.outputs:surface>

        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.85, 0.92, 1.0)
            float inputs:metallic = 0
            float inputs:roughness = 0.25
            token outputs:surface
        }
    }
}
